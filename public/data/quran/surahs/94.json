{"surahNo":94,"nameAr":"الشرح","nameEn":"The Relief","nameRoman":"Ash-Sharh","placeOfRevelation":"Meccan","totalAyahs":8,"ayahs":[{"ayahNo":1,"ayahNoQuran":6091,"textAr":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","textEn":"Have We not uplifted your heart for you ˹O Prophet˺,","juz":30,"manzil":7,"ruku":536,"hizbQuarter":239,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6092,"textAr":"وَوَضَعْنَا عَنكَ وِزْرَكَ","textEn":"relieved you of the burden","juz":30,"manzil":7,"ruku":536,"hizbQuarter":239,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6093,"textAr":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","textEn":"which weighed so heavily on your back,","juz":30,"manzil":7,"ruku":536,"hizbQuarter":239,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6094,"textAr":"وَرَفَعْنَا لَكَ ذِكْرَكَ","textEn":"and elevated your renown for you?","juz":30,"manzil":7,"ruku":536,"hizbQuarter":239,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6095,"textAr":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","textEn":"So, surely with hardship comes ease.","juz":30,"manzil":7,"ruku":536,"hizbQuarter":239,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6096,"textAr":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","textEn":"Surely with ˹that˺ hardship comes ˹more˺ ease.","juz":30,"manzil":7,"ruku":536,"hizbQuarter":239,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6097,"textAr":"فَإِذَا فَرَغْتَ فَٱنصَبْ","textEn":"So once you have fulfilled ˹your duty˺, strive ˹in devotion˺,","juz":30,"manzil":7,"ruku":536,"hizbQuarter":239,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":6098,"textAr":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","textEn":"turning to your Lord ˹alone˺ with hope.","juz":30,"manzil":7,"ruku":536,"hizbQuarter":239,"isSajdah":false}]}