{"surahNo":87,"nameAr":"الأعلى","nameEn":"The Most High","nameRoman":"Al-A'la","placeOfRevelation":"Meccan","totalAyahs":19,"ayahs":[{"ayahNo":1,"ayahNoQuran":5949,"textAr":"سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","textEn":"Glorify the Name of your Lord, the Most High,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":5950,"textAr":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","textEn":"Who created and ˹perfectly˺ fashioned ˹all˺,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":5951,"textAr":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","textEn":"and Who ordained precisely and inspired accordingly,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":5952,"textAr":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","textEn":"and Who brings forth ˹green˺ pasture,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5953,"textAr":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","textEn":"then reduces it to withered chaff.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":5954,"textAr":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","textEn":"We will have you recite ˹the Quran, O  Prophet,˺ so you will not forget ˹any of it˺,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":5955,"textAr":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","textEn":"unless Allah wills otherwise. He surely knows what is open and what is hidden.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":5956,"textAr":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","textEn":"We will facilitate for you the Way of Ease.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":5957,"textAr":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","textEn":"So ˹always˺ remind ˹with the Quran˺—˹even˺ if the reminder is beneficial ˹only to some˺.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":5958,"textAr":"سَيَذَّكَّرُ مَن يَخْشَىٰ","textEn":"Those in awe ˹of Allah˺ will be mindful ˹of it˺.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":5959,"textAr":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","textEn":"But it will be shunned by the most wretched,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":5960,"textAr":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","textEn":"who will burn in the greatest Fire,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":5961,"textAr":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","textEn":"where they will not ˹be able to˺ live or die.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":5962,"textAr":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","textEn":"Successful indeed are those who purify themselves,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":5963,"textAr":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","textEn":"remember the Name of their Lord, and pray.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":5964,"textAr":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","textEn":"But you ˹deniers only˺ prefer the life of this world,","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":5965,"textAr":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","textEn":"even though the Hereafter is far better and more lasting.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":5966,"textAr":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","textEn":"This is certainly ˹mentioned˺ in the earlier Scriptures—","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":5967,"textAr":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","textEn":"the Scriptures of Abraham and Moses.","juz":30,"manzil":7,"ruku":529,"hizbQuarter":237,"isSajdah":false}]}