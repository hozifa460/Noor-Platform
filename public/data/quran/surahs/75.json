{"surahNo":75,"nameAr":"القيامة","nameEn":"The Resurrection","nameRoman":"Al-Qiyamah","placeOfRevelation":"Meccan","totalAyahs":40,"ayahs":[{"ayahNo":1,"ayahNoQuran":5552,"textAr":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","textEn":"I do swear by the Day of Judgment!","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":5553,"textAr":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","textEn":"And I do swear by the self-reproaching soul!","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":5554,"textAr":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","textEn":"Do people think We cannot reassemble their bones?","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":5555,"textAr":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","textEn":"Yes ˹indeed˺! We are ˹most˺ capable of restoring ˹even˺ their very fingertips.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5556,"textAr":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","textEn":"Still people want to deny what is yet to come,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":5557,"textAr":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","textEn":"asking ˹mockingly˺, “When is this Day of Judgment?”","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":5558,"textAr":"فَإِذَا بَرِقَ ٱلْبَصَرُ","textEn":"But when the sight is stunned,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":5559,"textAr":"وَخَسَفَ ٱلْقَمَرُ","textEn":"and the moon is dimmed,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":5560,"textAr":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","textEn":"and the sun and the moon are brought together,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":5561,"textAr":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","textEn":"on that Day one will cry, “Where is the escape?”","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":5562,"textAr":"كَلَّا لَا وَزَرَ","textEn":"But no! There will be no refuge.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":5563,"textAr":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","textEn":"On that Day all will end up before your Lord.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":5564,"textAr":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","textEn":"All will then be informed of what they have sent forth and left behind.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":5565,"textAr":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ","textEn":"In fact, people will testify against their own souls,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":5566,"textAr":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","textEn":"despite the excuses they come up with.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":5567,"textAr":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","textEn":"Do not rush your tongue trying to memorize ˹a revelation of˺ the Quran.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":5568,"textAr":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","textEn":"It is certainly upon Us to ˹make you˺ memorize and recite it.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":5569,"textAr":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","textEn":"So once We have recited a revelation ˹through Gabriel˺, follow its recitation ˹closely˺.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":5570,"textAr":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","textEn":"Then it is surely upon Us to make it clear ˹to you˺.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":20,"ayahNoQuran":5571,"textAr":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","textEn":"But no! In fact, you love this fleeting world,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":21,"ayahNoQuran":5572,"textAr":"وَتَذَرُونَ ٱلْءَاخِرَةَ","textEn":"and neglect the Hereafter.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":22,"ayahNoQuran":5573,"textAr":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ","textEn":"On that Day ˹some˺ faces will be bright,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":23,"ayahNoQuran":5574,"textAr":"إِلَىٰ رَبِّهَا نَاظِرَةٌۭ","textEn":"looking at their Lord.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":24,"ayahNoQuran":5575,"textAr":"وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ","textEn":"And ˹other˺ faces will be gloomy,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":25,"ayahNoQuran":5576,"textAr":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ","textEn":"anticipating something devastating to befall them.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":26,"ayahNoQuran":5577,"textAr":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","textEn":"But no! ˹Beware of the day˺ when the soul reaches the collar bone ˹as it leaves˺,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":27,"ayahNoQuran":5578,"textAr":"وَقِيلَ مَنْ ۜ رَاقٍۢ","textEn":"and it will be said, “Is there any healer ˹who can save this life˺?”","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":28,"ayahNoQuran":5579,"textAr":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","textEn":"And the dying person realizes it is ˹their˺ time to depart,","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":29,"ayahNoQuran":5580,"textAr":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","textEn":"and ˹then˺ their feet are tied together ˹in a shroud˺.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":30,"ayahNoQuran":5581,"textAr":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","textEn":"On that day they will be driven to your Lord ˹alone˺.","juz":29,"manzil":7,"ruku":512,"hizbQuarter":231,"isSajdah":false},{"ayahNo":31,"ayahNoQuran":5582,"textAr":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","textEn":"This denier neither believed nor prayed,","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":32,"ayahNoQuran":5583,"textAr":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","textEn":"but persisted in denial and turned away,","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":33,"ayahNoQuran":5584,"textAr":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","textEn":"then went to their own people, walking boastfully.","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":34,"ayahNoQuran":5585,"textAr":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","textEn":"Woe to you, and more woe!","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":35,"ayahNoQuran":5586,"textAr":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","textEn":"Again, woe to you, and even more woe!","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":36,"ayahNoQuran":5587,"textAr":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","textEn":"Do people think they will be left without purpose?","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":37,"ayahNoQuran":5588,"textAr":"أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ","textEn":"Were they not ˹once˺ a sperm-drop emitted?","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":38,"ayahNoQuran":5589,"textAr":"ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ","textEn":"Then they became a clinging clot ˹of blood˺, then He developed and perfected their form,","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":39,"ayahNoQuran":5590,"textAr":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","textEn":"producing from it both sexes, male and female.","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false},{"ayahNo":40,"ayahNoQuran":5591,"textAr":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","textEn":"Is such ˹a Creator˺ unable to bring the dead back to life?","juz":29,"manzil":7,"ruku":513,"hizbQuarter":231,"isSajdah":false}]}