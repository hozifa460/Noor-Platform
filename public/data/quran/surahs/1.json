{"surahNo":1,"nameAr":"الفاتحة","nameEn":"The Opener","nameRoman":"Al-Fatihah","placeOfRevelation":"Meccan","totalAyahs":7,"ayahs":[{"ayahNo":1,"ayahNoQuran":1,"textAr":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","textEn":"In the Name of Allah—the Most Compassionate, Most Merciful.","juz":1,"manzil":1,"ruku":1,"hizbQuarter":1,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":2,"textAr":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","textEn":"All praise is for Allah—Lord of all worlds,","juz":1,"manzil":1,"ruku":1,"hizbQuarter":1,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":3,"textAr":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","textEn":"the Most Compassionate, Most Merciful,","juz":1,"manzil":1,"ruku":1,"hizbQuarter":1,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":4,"textAr":"مَٰلِكِ يَوْمِ ٱلدِّينِ","textEn":"Master of the Day of Judgment.","juz":1,"manzil":1,"ruku":1,"hizbQuarter":1,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5,"textAr":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","textEn":"You ˹alone˺ we worship and You ˹alone˺ we ask for help.","juz":1,"manzil":1,"ruku":1,"hizbQuarter":1,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6,"textAr":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","textEn":"Guide us along the Straight Path,","juz":1,"manzil":1,"ruku":1,"hizbQuarter":1,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":7,"textAr":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","textEn":"the Path of those You have blessed—not those You are displeased with, or those who are astray.","juz":1,"manzil":1,"ruku":1,"hizbQuarter":1,"isSajdah":false}]}