{"surahNo":96,"nameAr":"العلق","nameEn":"The Clot","nameRoman":"Al-'Alaq","placeOfRevelation":"Meccan","totalAyahs":19,"ayahs":[{"ayahNo":1,"ayahNoQuran":6107,"textAr":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","textEn":"Read, ˹O Prophet,˺ in the Name of your Lord Who created—","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6108,"textAr":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","textEn":"created humans from a clinging clot.","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6109,"textAr":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","textEn":"Read! And your Lord is the Most Generous,","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6110,"textAr":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","textEn":"Who taught by the pen—","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6111,"textAr":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","textEn":"taught humanity what they knew not.","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6112,"textAr":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","textEn":"Most certainly, one exceeds all bounds","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6113,"textAr":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","textEn":"once they think they are self-sufficient.","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":6114,"textAr":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","textEn":"˹But˺ surely to your Lord is the return ˹of all˺.","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":6115,"textAr":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","textEn":"Have you seen the man who prevents","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":6116,"textAr":"عَبْدًا إِذَا صَلَّىٰٓ","textEn":"a servant ˹of Ours˺ from praying?","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":6117,"textAr":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","textEn":"What if this ˹servant˺ is ˹rightly˺ guided,","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":6118,"textAr":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","textEn":"or encourages righteousness?","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":6119,"textAr":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","textEn":"What if that ˹man˺ persists in denial and turns away?","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":6120,"textAr":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","textEn":"Does he not know that Allah sees ˹all˺?","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":6121,"textAr":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","textEn":"But no! If he does not desist, We will certainly drag him by the forelock—","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":6122,"textAr":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","textEn":"a lying, sinful forelock.","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":6123,"textAr":"فَلْيَدْعُ نَادِيَهُۥ","textEn":"So let him call his associates.","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":6124,"textAr":"سَنَدْعُ ٱلزَّبَانِيَةَ","textEn":"We will call the wardens of Hell.","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":6125,"textAr":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","textEn":"Again, no! Never obey him ˹O Prophet˺! Rather, ˹continue to˺ prostrate and draw near ˹to Allah˺.","juz":30,"manzil":7,"ruku":538,"hizbQuarter":239,"isSajdah":true}]}