{"surahNo":107,"nameAr":"الماعون","nameEn":"The Small kindnesses","nameRoman":"Al-Ma'un","placeOfRevelation":"Meccan","totalAyahs":7,"ayahs":[{"ayahNo":1,"ayahNoQuran":6198,"textAr":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","textEn":"Have you seen the one who denies the ˹final˺ Judgment?","juz":30,"manzil":7,"ruku":549,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6199,"textAr":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","textEn":"That is the one who repulses the orphan,","juz":30,"manzil":7,"ruku":549,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6200,"textAr":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","textEn":"and does not encourage the feeding of the poor.","juz":30,"manzil":7,"ruku":549,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6201,"textAr":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","textEn":"So woe to those ˹hypocrites˺ who pray","juz":30,"manzil":7,"ruku":549,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6202,"textAr":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","textEn":"yet are unmindful of their prayers;","juz":30,"manzil":7,"ruku":549,"hizbQuarter":240,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6203,"textAr":"ٱلَّذِينَ هُمْ يُرَآءُونَ","textEn":"those who ˹only˺ show off,","juz":30,"manzil":7,"ruku":549,"hizbQuarter":240,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6204,"textAr":"وَيَمْنَعُونَ ٱلْمَاعُونَ","textEn":"and refuse to give ˹even the simplest˺ aid.","juz":30,"manzil":7,"ruku":549,"hizbQuarter":240,"isSajdah":false}]}