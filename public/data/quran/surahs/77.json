{"surahNo":77,"nameAr":"المرسلات","nameEn":"The Emissaries","nameRoman":"Al-Mursalat","placeOfRevelation":"Meccan","totalAyahs":50,"ayahs":[{"ayahNo":1,"ayahNoQuran":5623,"textAr":"وَٱلْمُرْسَلَٰتِ عُرْفًۭا","textEn":"By those ˹winds˺ sent forth successively,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":5624,"textAr":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا","textEn":"and those blowing violently,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":5625,"textAr":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا","textEn":"and those scattering ˹rainclouds˺ widely!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":5626,"textAr":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا","textEn":"And ˹by˺ those ˹angels˺ fully distinguishing ˹truth from falsehood˺,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5627,"textAr":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","textEn":"and those delivering revelation,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":5628,"textAr":"عُذْرًا أَوْ نُذْرًا","textEn":"ending excuses and giving warnings.","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":5629,"textAr":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ","textEn":"Surely, what you are promised will come to pass.","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":5630,"textAr":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","textEn":"So when the stars are put out,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":5631,"textAr":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","textEn":"and the sky is torn apart,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":5632,"textAr":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","textEn":"and the mountains are blown away,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":5633,"textAr":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","textEn":"and the messengers’ time ˹to testify˺ comes up—","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":5634,"textAr":"لِأَىِّ يَوْمٍ أُجِّلَتْ","textEn":"for which Day has all this been set?","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":5635,"textAr":"لِيَوْمِ ٱلْفَصْلِ","textEn":"For the Day of ˹Final˺ Decision!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":5636,"textAr":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","textEn":"And what will make you realize what the Day of Decision is?","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":5637,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":5638,"textAr":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","textEn":"Did We not destroy earlier disbelievers?","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":5639,"textAr":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","textEn":"And We will make the later disbelievers follow them.","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":5640,"textAr":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","textEn":"This is how We deal with the wicked.","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":5641,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":20,"ayahNoQuran":5642,"textAr":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","textEn":"Did We not create you from a humble fluid,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":21,"ayahNoQuran":5643,"textAr":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ","textEn":"placing it in a secure place","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":22,"ayahNoQuran":5644,"textAr":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","textEn":"until an appointed time?","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":23,"ayahNoQuran":5645,"textAr":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","textEn":"We ˹perfectly˺ ordained ˹its development˺. How excellent are We in doing so!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":24,"ayahNoQuran":5646,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":25,"ayahNoQuran":5647,"textAr":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","textEn":"Have We not made the earth a lodging","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":26,"ayahNoQuran":5648,"textAr":"أَحْيَآءًۭ وَأَمْوَٰتًۭا","textEn":"for the living and the dead,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":27,"ayahNoQuran":5649,"textAr":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا","textEn":"and placed upon it towering, firm mountains, and given you fresh water to drink?","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":28,"ayahNoQuran":5650,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":29,"ayahNoQuran":5651,"textAr":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","textEn":"˹The disbelievers will be told,˺ “Proceed into that ˹Fire˺ which you used to deny!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":30,"ayahNoQuran":5652,"textAr":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ","textEn":"Proceed into the shade ˹of smoke˺ which rises in three columns,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":31,"ayahNoQuran":5653,"textAr":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","textEn":"providing neither coolness nor shelter from the flames.","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":32,"ayahNoQuran":5654,"textAr":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","textEn":"Indeed, it hurls sparks ˹as big˺ as huge castles,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":33,"ayahNoQuran":5655,"textAr":"كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ","textEn":"and ˹as dark˺ as black camels.”","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":34,"ayahNoQuran":5656,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":35,"ayahNoQuran":5657,"textAr":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","textEn":"On that Day they will not ˹be in a position to˺ speak,","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":36,"ayahNoQuran":5658,"textAr":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","textEn":"nor will they be permitted to offer excuses.","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":37,"ayahNoQuran":5659,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":38,"ayahNoQuran":5660,"textAr":"هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","textEn":"˹They will be told by Allah,˺ “This is the Day of ˹Final˺ Decision: We have gathered you along with earlier disbelievers ˹for punishment˺.","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":39,"ayahNoQuran":5661,"textAr":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","textEn":"So if you have a scheme ˹to save yourselves˺, then use it against Me.”","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":40,"ayahNoQuran":5662,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":516,"hizbQuarter":232,"isSajdah":false},{"ayahNo":41,"ayahNoQuran":5663,"textAr":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ","textEn":"Indeed, the righteous will be amid ˹cool˺ shade and springs","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":42,"ayahNoQuran":5664,"textAr":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","textEn":"and any fruit they desire.","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":43,"ayahNoQuran":5665,"textAr":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","textEn":"˹They will be told,˺ “Eat and drink happily for what you used to do.”","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":44,"ayahNoQuran":5666,"textAr":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","textEn":"Surely this is how We reward the good-doers.","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":45,"ayahNoQuran":5667,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"˹But˺ woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":46,"ayahNoQuran":5668,"textAr":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","textEn":"“Eat and enjoy yourselves for a little while, ˹for˺ you are truly wicked.”","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":47,"ayahNoQuran":5669,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":48,"ayahNoQuran":5670,"textAr":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","textEn":"When it is said to them, “Bow down ˹before Allah,” they do not bow.","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":49,"ayahNoQuran":5671,"textAr":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","textEn":"Woe on that Day to the deniers!","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false},{"ayahNo":50,"ayahNoQuran":5672,"textAr":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","textEn":"So what message after this ˹Quran˺ would they believe in?","juz":29,"manzil":7,"ruku":517,"hizbQuarter":232,"isSajdah":false}]}