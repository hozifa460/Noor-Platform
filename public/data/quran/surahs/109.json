{"surahNo":109,"nameAr":"الكافرون","nameEn":"The Disbelievers","nameRoman":"Al-Kafirun","placeOfRevelation":"Meccan","totalAyahs":6,"ayahs":[{"ayahNo":1,"ayahNoQuran":6208,"textAr":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","textEn":"Say, ˹O Prophet,˺ “O you disbelievers!","juz":30,"manzil":7,"ruku":551,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6209,"textAr":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","textEn":"I do not worship what you worship,","juz":30,"manzil":7,"ruku":551,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6210,"textAr":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","textEn":"nor do you worship what I worship.","juz":30,"manzil":7,"ruku":551,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6211,"textAr":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","textEn":"I will never worship what you worship,","juz":30,"manzil":7,"ruku":551,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6212,"textAr":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","textEn":"nor will you ever worship what I worship.","juz":30,"manzil":7,"ruku":551,"hizbQuarter":240,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6213,"textAr":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","textEn":"You have your way, and I have my Way.”","juz":30,"manzil":7,"ruku":551,"hizbQuarter":240,"isSajdah":false}]}