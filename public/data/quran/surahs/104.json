{"surahNo":104,"nameAr":"الهمزة","nameEn":"The Traducer","nameRoman":"Al-Humazah","placeOfRevelation":"Meccan","totalAyahs":9,"ayahs":[{"ayahNo":1,"ayahNoQuran":6180,"textAr":"وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","textEn":"Woe to every backbiter, slanderer,","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6181,"textAr":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","textEn":"who amasses wealth ˹greedily˺ and counts it ˹repeatedly˺,","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6182,"textAr":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","textEn":"thinking that their wealth will make them immortal!","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6183,"textAr":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","textEn":"Not at all! Such a person will certainly be tossed into the Crusher.","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6184,"textAr":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","textEn":"And what will make you realize what the Crusher is?","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6185,"textAr":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","textEn":"˹It is˺ Allah’s kindled Fire,","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6186,"textAr":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","textEn":"which rages over the hearts.","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":6187,"textAr":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","textEn":"It will be sealed over them,","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":6188,"textAr":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","textEn":"˹tightly secured˺ with long braces.","juz":30,"manzil":7,"ruku":546,"hizbQuarter":240,"isSajdah":false}]}