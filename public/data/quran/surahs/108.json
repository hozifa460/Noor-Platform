{"surahNo":108,"nameAr":"الكوثر","nameEn":"The Abundance","nameRoman":"Al-Kawthar","placeOfRevelation":"Meccan","totalAyahs":3,"ayahs":[{"ayahNo":1,"ayahNoQuran":6205,"textAr":"إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","textEn":"Indeed, We have granted you ˹O Prophet˺ abundant goodness.","juz":30,"manzil":7,"ruku":550,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6206,"textAr":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","textEn":"So pray and sacrifice to your Lord ˹alone˺.","juz":30,"manzil":7,"ruku":550,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6207,"textAr":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","textEn":"Only the one who hates you is truly cut off ˹from any goodness˺.","juz":30,"manzil":7,"ruku":550,"hizbQuarter":240,"isSajdah":false}]}