{"surahNo":101,"nameAr":"القارعة","nameEn":"The Calamity","nameRoman":"Al-Qari'ah","placeOfRevelation":"Meccan","totalAyahs":11,"ayahs":[{"ayahNo":1,"ayahNoQuran":6158,"textAr":"ٱلْقَارِعَةُ","textEn":"The Striking Disaster!","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6159,"textAr":"مَا ٱلْقَارِعَةُ","textEn":"What is the Striking Disaster?","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6160,"textAr":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","textEn":"And what will make you realize what the Striking Disaster is?","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6161,"textAr":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","textEn":"˹It is˺ the Day people will be like scattered moths,","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6162,"textAr":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","textEn":"and the mountains will be like carded wool.","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6163,"textAr":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","textEn":"So as for those whose scale is heavy ˹with good deeds˺,","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6164,"textAr":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","textEn":"they will be in a life of bliss.","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":6165,"textAr":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","textEn":"And as for those whose scale is light,","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":6166,"textAr":"فَأُمُّهُۥ هَاوِيَةٌۭ","textEn":"their home will be the abyss.","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":6167,"textAr":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","textEn":"And what will make you realize what that is?","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":6168,"textAr":"نَارٌ حَامِيَةٌۢ","textEn":"˹It is˺ a scorching Fire.","juz":30,"manzil":7,"ruku":543,"hizbQuarter":240,"isSajdah":false}]}