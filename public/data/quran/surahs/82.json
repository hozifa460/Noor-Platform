{"surahNo":82,"nameAr":"الإنفطار","nameEn":"The Cleaving","nameRoman":"Al-Infitar","placeOfRevelation":"Meccan","totalAyahs":19,"ayahs":[{"ayahNo":1,"ayahNoQuran":5830,"textAr":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","textEn":"When the sky splits open,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":5831,"textAr":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","textEn":"and when the stars fall away,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":5832,"textAr":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","textEn":"and when the seas burst forth,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":5833,"textAr":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","textEn":"and when the graves spill out,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5834,"textAr":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","textEn":"˹then˺ each soul will know what it has sent forth or left behind.","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":5835,"textAr":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","textEn":"O humanity! What has emboldened you against your Lord, the Most Generous,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":5836,"textAr":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","textEn":"Who created you, fashioned you, and perfected your design,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":5837,"textAr":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","textEn":"moulding you in whatever form He willed?","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":5838,"textAr":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","textEn":"But no! In fact, you deny the ˹final˺ Judgment,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":5839,"textAr":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","textEn":"while you are certainly observed by vigilant,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":5840,"textAr":"كِرَامًۭا كَٰتِبِينَ","textEn":"honourable angels, recording ˹everything˺.","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":5841,"textAr":"يَعْلَمُونَ مَا تَفْعَلُونَ","textEn":"They know whatever you do.","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":5842,"textAr":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","textEn":"Indeed, the virtuous will be in bliss,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":5843,"textAr":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","textEn":"and the wicked will be in Hell,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":5844,"textAr":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","textEn":"burning in it on Judgment Day,","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":5845,"textAr":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","textEn":"and they will have no escape from it.","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":5846,"textAr":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","textEn":"What will make you realize what Judgment Day is?","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":5847,"textAr":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","textEn":"Again, what will make you realize what Judgment Day is?","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":5848,"textAr":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","textEn":"˹It is˺ the Day no soul will be of ˹any˺ benefit to another whatsoever, for all authority on that Day belongs to Allah ˹entirely˺.","juz":30,"manzil":7,"ruku":524,"hizbQuarter":235,"isSajdah":false}]}