{"surahNo":102,"nameAr":"التكاثر","nameEn":"The Rivalry in world increase","nameRoman":"At-Takathur","placeOfRevelation":"Meccan","totalAyahs":8,"ayahs":[{"ayahNo":1,"ayahNoQuran":6169,"textAr":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","textEn":"Competition for more ˹gains˺ diverts you ˹from Allah˺,","juz":30,"manzil":7,"ruku":544,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6170,"textAr":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","textEn":"until you end up in ˹your˺ graves.","juz":30,"manzil":7,"ruku":544,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6171,"textAr":"كَلَّا سَوْفَ تَعْلَمُونَ","textEn":"But no! You will soon come to know.","juz":30,"manzil":7,"ruku":544,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6172,"textAr":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","textEn":"Again, no! You will soon come to know.","juz":30,"manzil":7,"ruku":544,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6173,"textAr":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","textEn":"Indeed, if you were to know ˹your fate˺ with certainty, ˹you would have acted differently˺.","juz":30,"manzil":7,"ruku":544,"hizbQuarter":240,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6174,"textAr":"لَتَرَوُنَّ ٱلْجَحِيمَ","textEn":"˹But˺ you will surely see the Hellfire.","juz":30,"manzil":7,"ruku":544,"hizbQuarter":240,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6175,"textAr":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","textEn":"Again, you will surely see it with the eye of certainty.","juz":30,"manzil":7,"ruku":544,"hizbQuarter":240,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":6176,"textAr":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","textEn":"Then, on that Day, you will definitely be questioned about ˹your worldly˺ pleasures.","juz":30,"manzil":7,"ruku":544,"hizbQuarter":240,"isSajdah":false}]}