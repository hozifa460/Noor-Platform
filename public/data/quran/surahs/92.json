{"surahNo":92,"nameAr":"الليل","nameEn":"The Night","nameRoman":"Al-Layl","placeOfRevelation":"Meccan","totalAyahs":21,"ayahs":[{"ayahNo":1,"ayahNoQuran":6059,"textAr":"وَٱلَّيْلِ إِذَا يَغْشَىٰ","textEn":"By the night when it covers,","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6060,"textAr":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","textEn":"and the day when it shines!","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6061,"textAr":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","textEn":"And by ˹the One˺ Who created male and female!","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6062,"textAr":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","textEn":"Surely the ends you strive for are diverse.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6063,"textAr":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","textEn":"As for the one who is charitable, mindful ˹of Allah˺,","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6064,"textAr":"وَصَدَّقَ بِٱلْحُسْنَىٰ","textEn":"and ˹firmly˺ believes in the finest reward,","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6065,"textAr":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","textEn":"We will facilitate for them the Way of Ease.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":6066,"textAr":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","textEn":"And as for the one who is stingy, indifferent ˹to Allah˺,","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":6067,"textAr":"وَكَذَّبَ بِٱلْحُسْنَىٰ","textEn":"and ˹staunchly˺ denies the finest reward,","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":6068,"textAr":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","textEn":"We will facilitate for them the path of hardship.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":6069,"textAr":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","textEn":"And their wealth will be of no benefit to them when they tumble ˹into Hell˺.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":6070,"textAr":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","textEn":"It is certainly upon Us ˹alone˺ to show ˹the way to˺ guidance.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":6071,"textAr":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","textEn":"And surely to Us ˹alone˺ belong this life and the next.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":6072,"textAr":"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ","textEn":"And so I have warned you of a raging Fire,","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":6073,"textAr":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","textEn":"in which none will burn except the most wretched—","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":6074,"textAr":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","textEn":"who deny and turn away.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":6075,"textAr":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","textEn":"But the righteous will be spared from it—","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":6076,"textAr":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","textEn":"who donate ˹some of˺ their wealth only to purify themselves,","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":6077,"textAr":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ","textEn":"not in return for someone’s favours,","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":20,"ayahNoQuran":6078,"textAr":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","textEn":"but seeking the pleasure of their Lord, the Most High.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false},{"ayahNo":21,"ayahNoQuran":6079,"textAr":"وَلَسَوْفَ يَرْضَىٰ","textEn":"They will certainly be pleased.","juz":30,"manzil":7,"ruku":534,"hizbQuarter":238,"isSajdah":false}]}