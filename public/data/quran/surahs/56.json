{"surahNo":56,"nameAr":"الواقعة","nameEn":"The Inevitable","nameRoman":"Al-Waqi'ah","placeOfRevelation":"Meccan","totalAyahs":96,"ayahs":[{"ayahNo":1,"ayahNoQuran":4980,"textAr":"إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","textEn":"When the Inevitable Event takes place,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":4981,"textAr":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","textEn":"then no one can deny it has come.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":4982,"textAr":"خَافِضَةٌۭ رَّافِعَةٌ","textEn":"It will debase ˹some˺ and elevate ˹others˺.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":4983,"textAr":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا","textEn":"When the earth will be violently shaken,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":4984,"textAr":"وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا","textEn":"and the mountains will be crushed to pieces,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":4985,"textAr":"فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا","textEn":"becoming scattered ˹particles of˺ dust,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":4986,"textAr":"وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ","textEn":"you will ˹all˺ be ˹divided into˺ three groups:","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":4987,"textAr":"فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ","textEn":"the people of the right, how ˹blessed˺ will they be;","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":4988,"textAr":"وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","textEn":"the people of the left, how ˹miserable˺ will they be;","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":4989,"textAr":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ","textEn":"and the foremost ˹in faith˺ will be the foremost ˹in Paradise˺.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":4990,"textAr":"أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ","textEn":"They are the ones nearest ˹to Allah˺,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":4991,"textAr":"فِى جَنَّٰتِ ٱلنَّعِيمِ","textEn":"in the Gardens of Bliss.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":4992,"textAr":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","textEn":"˹They will be˺ a multitude from earlier generations","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":4993,"textAr":"وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ","textEn":"and a few from later generations.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":4994,"textAr":"عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ","textEn":"˹All will be˺ on jewelled thrones,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":4995,"textAr":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ","textEn":"reclining face to face.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":4996,"textAr":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ","textEn":"They will be waited on by eternal youths","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":4997,"textAr":"بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ","textEn":"with cups, pitchers, and a drink ˹of pure wine˺ from a flowing stream,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":4998,"textAr":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","textEn":"that will cause them neither headache nor intoxication.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":20,"ayahNoQuran":4999,"textAr":"وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ","textEn":"˹They will also be served˺ any fruit they choose","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":21,"ayahNoQuran":5000,"textAr":"وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ","textEn":"and meat from any bird they desire.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":22,"ayahNoQuran":5001,"textAr":"وَحُورٌ عِينٌۭ","textEn":"And ˹they will have˺ maidens with gorgeous eyes,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":23,"ayahNoQuran":5002,"textAr":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","textEn":"like pristine pearls,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":24,"ayahNoQuran":5003,"textAr":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","textEn":"˹all˺ as a reward for what they used to do.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":25,"ayahNoQuran":5004,"textAr":"لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا","textEn":"There they will never hear any idle or sinful talk—","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":26,"ayahNoQuran":5005,"textAr":"إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا","textEn":"only good and virtuous speech.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":27,"ayahNoQuran":5006,"textAr":"وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ","textEn":"And the people of the right—how ˹blessed˺ will they be!","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":28,"ayahNoQuran":5007,"textAr":"فِى سِدْرٍۢ مَّخْضُودٍۢ","textEn":"˹They will be˺ amid thornless lote trees,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":29,"ayahNoQuran":5008,"textAr":"وَطَلْحٍۢ مَّنضُودٍۢ","textEn":"clusters of bananas,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":30,"ayahNoQuran":5009,"textAr":"وَظِلٍّۢ مَّمْدُودٍۢ","textEn":"extended shade,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":31,"ayahNoQuran":5010,"textAr":"وَمَآءٍۢ مَّسْكُوبٍۢ","textEn":"flowing water,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":32,"ayahNoQuran":5011,"textAr":"وَفَٰكِهَةٍۢ كَثِيرَةٍۢ","textEn":"abundant fruit—","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":33,"ayahNoQuran":5012,"textAr":"لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ","textEn":"never out of season nor forbidden—","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":34,"ayahNoQuran":5013,"textAr":"وَفُرُشٍۢ مَّرْفُوعَةٍ","textEn":"and elevated furnishings.","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":35,"ayahNoQuran":5014,"textAr":"إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ","textEn":"Indeed, We will have perfectly created their mates,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":36,"ayahNoQuran":5015,"textAr":"فَجَعَلْنَٰهُنَّ أَبْكَارًا","textEn":"making them virgins,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":37,"ayahNoQuran":5016,"textAr":"عُرُبًا أَتْرَابًۭا","textEn":"loving and of equal age,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":38,"ayahNoQuran":5017,"textAr":"لِّأَصْحَٰبِ ٱلْيَمِينِ","textEn":"for the people of the right,","juz":27,"manzil":7,"ruku":469,"hizbQuarter":214,"isSajdah":false},{"ayahNo":39,"ayahNoQuran":5018,"textAr":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","textEn":"˹who will be˺ a multitude from earlier generations","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":40,"ayahNoQuran":5019,"textAr":"وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ","textEn":"and a multitude from later generations.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":41,"ayahNoQuran":5020,"textAr":"وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ","textEn":"And the people of the left—how ˹miserable˺ will they be!","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":42,"ayahNoQuran":5021,"textAr":"فِى سَمُومٍۢ وَحَمِيمٍۢ","textEn":"˹They will be˺ in scorching heat and boiling water,","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":43,"ayahNoQuran":5022,"textAr":"وَظِلٍّۢ مِّن يَحْمُومٍۢ","textEn":"in the shade of black smoke,","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":44,"ayahNoQuran":5023,"textAr":"لَّا بَارِدٍۢ وَلَا كَرِيمٍ","textEn":"neither cool nor refreshing.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":45,"ayahNoQuran":5024,"textAr":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","textEn":"Indeed, before this ˹torment˺ they were spoiled by luxury,","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":46,"ayahNoQuran":5025,"textAr":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","textEn":"and persisted in the worst of sin.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":47,"ayahNoQuran":5026,"textAr":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","textEn":"They used to ask ˹mockingly˺, “When we are dead and reduced to dust and bones, will we really be resurrected?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":48,"ayahNoQuran":5027,"textAr":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","textEn":"And our forefathers as well?”","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":49,"ayahNoQuran":5028,"textAr":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ","textEn":"Say, ˹O Prophet,˺ “Most certainly, earlier and later generations","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":50,"ayahNoQuran":5029,"textAr":"لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ","textEn":"will surely be gathered ˹together˺ for the appointed Day.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":51,"ayahNoQuran":5030,"textAr":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","textEn":"Then you, O  misguided deniers,","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":52,"ayahNoQuran":5031,"textAr":"لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ","textEn":"will certainly eat from ˹the fruit of˺ the trees of Zaqqûm,","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":53,"ayahNoQuran":5032,"textAr":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","textEn":"filling up ˹your˺ bellies with it.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":54,"ayahNoQuran":5033,"textAr":"فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ","textEn":"Then on top of that you will drink boiling water—","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":55,"ayahNoQuran":5034,"textAr":"فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ","textEn":"and you will drink ˹it˺ like thirsty camels do.”","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":56,"ayahNoQuran":5035,"textAr":"هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","textEn":"This will be their accommodation on the Day of Judgment.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":57,"ayahNoQuran":5036,"textAr":"نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ","textEn":"It is We Who created you. Will you not then believe ˹in resurrection˺?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":58,"ayahNoQuran":5037,"textAr":"أَفَرَءَيْتُم مَّا تُمْنُونَ","textEn":"Have you considered what you ejaculate?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":59,"ayahNoQuran":5038,"textAr":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ","textEn":"Is it you who create ˹a child out of˺ it, or is it We Who do so?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":60,"ayahNoQuran":5039,"textAr":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","textEn":"We have ordained death for ˹all of˺ you, and We cannot be prevented","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":61,"ayahNoQuran":5040,"textAr":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","textEn":"from transforming and recreating you in forms unknown to you.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":62,"ayahNoQuran":5041,"textAr":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","textEn":"You already know how you were first created. Will you not then be mindful?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":63,"ayahNoQuran":5042,"textAr":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","textEn":"Have you considered what you sow?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":64,"ayahNoQuran":5043,"textAr":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","textEn":"Is it you who cause it to grow, or is it We Who do so?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":65,"ayahNoQuran":5044,"textAr":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ","textEn":"If We willed, We could simply reduce this ˹harvest˺ to chaff, leaving you to lament,","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":66,"ayahNoQuran":5045,"textAr":"إِنَّا لَمُغْرَمُونَ","textEn":"“We have truly suffered a ˹great˺ loss.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":67,"ayahNoQuran":5046,"textAr":"بَلْ نَحْنُ مَحْرُومُونَ","textEn":"In fact, we have been deprived ˹of our livelihood˺.”","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":68,"ayahNoQuran":5047,"textAr":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","textEn":"Have you considered the water you drink?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":69,"ayahNoQuran":5048,"textAr":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","textEn":"Is it you who bring it down from the clouds, or is it We Who do so?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":70,"ayahNoQuran":5049,"textAr":"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ","textEn":"If We willed, We could make it salty. Will you not then give thanks?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":71,"ayahNoQuran":5050,"textAr":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","textEn":"Have you considered the fire you kindle?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":72,"ayahNoQuran":5051,"textAr":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","textEn":"Is it you who produce its trees, or is it We Who do so?","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":73,"ayahNoQuran":5052,"textAr":"نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ","textEn":"We have made it ˹as˺ a reminder ˹of the Hellfire˺ and a provision for the travellers.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":74,"ayahNoQuran":5053,"textAr":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","textEn":"So glorify the Name of your Lord, the Greatest.","juz":27,"manzil":7,"ruku":470,"hizbQuarter":214,"isSajdah":false},{"ayahNo":75,"ayahNoQuran":5054,"textAr":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","textEn":"So I do swear by the positions of the stars—","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":76,"ayahNoQuran":5055,"textAr":"وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ","textEn":"and this, if only you knew, is indeed a great oath—","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":77,"ayahNoQuran":5056,"textAr":"إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ","textEn":"that this is truly a noble Quran,","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":78,"ayahNoQuran":5057,"textAr":"فِى كِتَٰبٍۢ مَّكْنُونٍۢ","textEn":"in a well-preserved Record,","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":79,"ayahNoQuran":5058,"textAr":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","textEn":"touched by none except the purified ˹angels˺.","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":80,"ayahNoQuran":5059,"textAr":"تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","textEn":"˹It is˺ a revelation from the Lord of all worlds.","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":81,"ayahNoQuran":5060,"textAr":"أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","textEn":"How can you then take this message lightly,","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":82,"ayahNoQuran":5061,"textAr":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","textEn":"and repay ˹Allah for˺ your provisions with denial?","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":83,"ayahNoQuran":5062,"textAr":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","textEn":"Why then ˹are you helpless˺ when the soul ˹of a dying person˺ reaches ˹their˺ throat,","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":84,"ayahNoQuran":5063,"textAr":"وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ","textEn":"while you are looking on?","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":85,"ayahNoQuran":5064,"textAr":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ","textEn":"And We are nearer to such a person than you, but you cannot see.","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":86,"ayahNoQuran":5065,"textAr":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ","textEn":"Now, if you are not subject to Our Will ˹as you claim˺,","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":87,"ayahNoQuran":5066,"textAr":"تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ","textEn":"bring that soul back, if what you say is true.","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":88,"ayahNoQuran":5067,"textAr":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ","textEn":"So, if the deceased is one of those brought near ˹to Us˺,","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":89,"ayahNoQuran":5068,"textAr":"فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ","textEn":"then ˹such a person will have˺ serenity, fragrance, and a Garden of Bliss.","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":90,"ayahNoQuran":5069,"textAr":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ","textEn":"And if the deceased is one of the people of the right,","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":91,"ayahNoQuran":5070,"textAr":"فَسَلَٰمٌۭ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ","textEn":"then ˹they will be told,˺ “Greetings to you from the people of the right.”","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":92,"ayahNoQuran":5071,"textAr":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","textEn":"But if such person is one of the misguided deniers,","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":93,"ayahNoQuran":5072,"textAr":"فَنُزُلٌۭ مِّنْ حَمِيمٍۢ","textEn":"then their accommodation will be boiling water ˹to drink˺","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":94,"ayahNoQuran":5073,"textAr":"وَتَصْلِيَةُ جَحِيمٍ","textEn":"and burning in Hellfire.","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":95,"ayahNoQuran":5074,"textAr":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ","textEn":"Indeed, this is the absolute truth.","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false},{"ayahNo":96,"ayahNoQuran":5075,"textAr":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","textEn":"So glorify the Name of your Lord, the Greatest.","juz":27,"manzil":7,"ruku":471,"hizbQuarter":215,"isSajdah":false}]}