{"surahNo":93,"nameAr":"الضحى","nameEn":"The Morning Hours","nameRoman":"Ad-Duhaa","placeOfRevelation":"Meccan","totalAyahs":11,"ayahs":[{"ayahNo":1,"ayahNoQuran":6080,"textAr":"وَٱلضُّحَىٰ","textEn":"By the morning sunlight,","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6081,"textAr":"وَٱلَّيْلِ إِذَا سَجَىٰ","textEn":"and the night when it falls still!","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6082,"textAr":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","textEn":"Your Lord ˹O Prophet˺ has not abandoned you, nor has He become hateful ˹of you˺.","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6083,"textAr":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","textEn":"And the next life is certainly far better for you than this one.","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6084,"textAr":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","textEn":"And ˹surely˺ your Lord will give so much to you that you will be pleased.","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6085,"textAr":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","textEn":"Did He not find you as an orphan then sheltered you?","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6086,"textAr":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","textEn":"Did He not find you unguided then guided you?","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":6087,"textAr":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","textEn":"And did He not find you needy then satisfied your needs?","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":6088,"textAr":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","textEn":"So do not oppress the orphan,","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":6089,"textAr":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","textEn":"nor repulse the beggar.","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":6090,"textAr":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","textEn":"And proclaim the blessings of your Lord.","juz":30,"manzil":7,"ruku":535,"hizbQuarter":238,"isSajdah":false}]}