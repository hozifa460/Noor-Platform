{"surahNo":114,"nameAr":"الناس","nameEn":"The Mankind","nameRoman":"An-Nas","placeOfRevelation":"Meccan","totalAyahs":6,"ayahs":[{"ayahNo":1,"ayahNoQuran":6231,"textAr":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","textEn":"Say, ˹O Prophet,˺ “I seek refuge in the Lord of humankind,","juz":30,"manzil":7,"ruku":556,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6232,"textAr":"مَلِكِ ٱلنَّاسِ","textEn":"the Master of humankind,","juz":30,"manzil":7,"ruku":556,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6233,"textAr":"إِلَٰهِ ٱلنَّاسِ","textEn":"the God of humankind,","juz":30,"manzil":7,"ruku":556,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6234,"textAr":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","textEn":"from the evil of the lurking whisperer—","juz":30,"manzil":7,"ruku":556,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6235,"textAr":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","textEn":"who whispers into the hearts of humankind—","juz":30,"manzil":7,"ruku":556,"hizbQuarter":240,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6236,"textAr":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","textEn":"from among jinn and humankind.”","juz":30,"manzil":7,"ruku":556,"hizbQuarter":240,"isSajdah":false}]}