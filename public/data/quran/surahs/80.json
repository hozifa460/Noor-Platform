{"surahNo":80,"nameAr":"عبس","nameEn":"He Frowned","nameRoman":"Abasa","placeOfRevelation":"Meccan","totalAyahs":42,"ayahs":[{"ayahNo":1,"ayahNoQuran":5759,"textAr":"عَبَسَ وَتَوَلَّىٰٓ","textEn":"He frowned and turned ˹his attention˺ away,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":5760,"textAr":"أَن جَآءَهُ ٱلْأَعْمَىٰ","textEn":"˹simply˺ because the blind man came to him ˹interrupting˺.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":5761,"textAr":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","textEn":"You never know ˹O Prophet˺, perhaps he may be purified,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":5762,"textAr":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","textEn":"or he may be mindful, benefitting from the reminder.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5763,"textAr":"أَمَّا مَنِ ٱسْتَغْنَىٰ","textEn":"As for the one who was indifferent,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":5764,"textAr":"فَأَنتَ لَهُۥ تَصَدَّىٰ","textEn":"you gave him your ˹undivided˺ attention,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":5765,"textAr":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","textEn":"even though you are not to blame if he would not be purified.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":5766,"textAr":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","textEn":"But as for the one who came to you, eager ˹to learn˺,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":5767,"textAr":"وَهُوَ يَخْشَىٰ","textEn":"being in awe ˹of Allah˺,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":5768,"textAr":"فَأَنتَ عَنْهُ تَلَهَّىٰ","textEn":"you were inattentive to him.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":5769,"textAr":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","textEn":"But no! This ˹revelation˺ is truly a reminder.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":5770,"textAr":"فَمَن شَآءَ ذَكَرَهُۥ","textEn":"So let whoever wills be mindful of it.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":5771,"textAr":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","textEn":"It is ˹written˺ on pages held in honour—","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":5772,"textAr":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","textEn":"highly esteemed, purified—","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":5773,"textAr":"بِأَيْدِى سَفَرَةٍۢ","textEn":"by the hands of angel-scribes,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":5774,"textAr":"كِرَامٍۭ بَرَرَةٍۢ","textEn":"honourable and virtuous.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":5775,"textAr":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","textEn":"Condemned are ˹disbelieving˺ humans! How ungrateful they are ˹to Allah˺!","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":5776,"textAr":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","textEn":"From what substance did He create them?","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":5777,"textAr":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","textEn":"He created them from a sperm-drop, and ordained their development.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":20,"ayahNoQuran":5778,"textAr":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","textEn":"Then He makes the way easy for them,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":21,"ayahNoQuran":5779,"textAr":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","textEn":"then causes them to die and be buried.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":22,"ayahNoQuran":5780,"textAr":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","textEn":"Then when He wills, He will resurrect them.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":23,"ayahNoQuran":5781,"textAr":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","textEn":"But no! They have failed to comply with what He ordered.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":24,"ayahNoQuran":5782,"textAr":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","textEn":"Let people then consider their food:","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":25,"ayahNoQuran":5783,"textAr":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","textEn":"how We pour down rain in abundance","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":26,"ayahNoQuran":5784,"textAr":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","textEn":"and meticulously split the earth open ˹for sprouts˺,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":27,"ayahNoQuran":5785,"textAr":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","textEn":"causing grain to grow in it,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":28,"ayahNoQuran":5786,"textAr":"وَعِنَبًۭا وَقَضْبًۭا","textEn":"as well as grapes and greens,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":29,"ayahNoQuran":5787,"textAr":"وَزَيْتُونًۭا وَنَخْلًۭا","textEn":"and olives and palm trees,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":30,"ayahNoQuran":5788,"textAr":"وَحَدَآئِقَ غُلْبًۭا","textEn":"and dense orchards,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":31,"ayahNoQuran":5789,"textAr":"وَفَٰكِهَةًۭ وَأَبًّۭا","textEn":"and fruit and fodder—","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":32,"ayahNoQuran":5790,"textAr":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","textEn":"all as ˹a means of˺ sustenance for you and your animals.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":33,"ayahNoQuran":5791,"textAr":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","textEn":"Then, when the Deafening Blast comes to pass—","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":34,"ayahNoQuran":5792,"textAr":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","textEn":"on that Day every person will flee from their own siblings,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":35,"ayahNoQuran":5793,"textAr":"وَأُمِّهِۦ وَأَبِيهِ","textEn":"and ˹even˺ their mother and father,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":36,"ayahNoQuran":5794,"textAr":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","textEn":"and ˹even˺ their spouse and children.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":37,"ayahNoQuran":5795,"textAr":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","textEn":"For then everyone will have enough concern of their own.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":38,"ayahNoQuran":5796,"textAr":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","textEn":"On that Day ˹some˺ faces will be bright,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":39,"ayahNoQuran":5797,"textAr":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","textEn":"laughing and rejoicing,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":40,"ayahNoQuran":5798,"textAr":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","textEn":"while ˹other˺ faces will be dusty,","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":41,"ayahNoQuran":5799,"textAr":"تَرْهَقُهَا قَتَرَةٌ","textEn":"cast in gloom—","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false},{"ayahNo":42,"ayahNoQuran":5800,"textAr":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","textEn":"those are the disbelievers, the ˹wicked˺ sinners.","juz":30,"manzil":7,"ruku":522,"hizbQuarter":234,"isSajdah":false}]}