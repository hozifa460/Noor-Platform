{"surahNo":103,"nameAr":"العصر","nameEn":"The Declining Day","nameRoman":"Al-'Asr","placeOfRevelation":"Meccan","totalAyahs":3,"ayahs":[{"ayahNo":1,"ayahNoQuran":6177,"textAr":"وَٱلْعَصْرِ","textEn":"By the ˹passage of˺ time!","juz":30,"manzil":7,"ruku":545,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6178,"textAr":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","textEn":"Surely humanity is in ˹grave˺ loss,","juz":30,"manzil":7,"ruku":545,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6179,"textAr":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","textEn":"except those who have faith, do good, and urge each other to the truth, and urge each other to perseverance.","juz":30,"manzil":7,"ruku":545,"hizbQuarter":240,"isSajdah":false}]}