{"surahNo":88,"nameAr":"الغاشية","nameEn":"The Overwhelming","nameRoman":"Al-Ghashiyah","placeOfRevelation":"Meccan","totalAyahs":26,"ayahs":[{"ayahNo":1,"ayahNoQuran":5968,"textAr":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","textEn":"Has the news of the Overwhelming Event reached you ˹O Prophet˺?","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":5969,"textAr":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","textEn":"On that Day ˹some˺ faces will be downcast,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":5970,"textAr":"عَامِلَةٌۭ نَّاصِبَةٌۭ","textEn":"˹totally˺ overburdened, exhausted,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":5971,"textAr":"تَصْلَىٰ نَارًا حَامِيَةًۭ","textEn":"burning in a scorching Fire,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5972,"textAr":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","textEn":"left to drink from a scalding spring.","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":5973,"textAr":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","textEn":"They will have no food except a foul, thorny shrub,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":5974,"textAr":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","textEn":"neither nourishing nor satisfying hunger.","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":5975,"textAr":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","textEn":"On that Day ˹other˺ faces will be glowing with bliss,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":5976,"textAr":"لِّسَعْيِهَا رَاضِيَةٌۭ","textEn":"˹fully˺ pleased with their striving,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":5977,"textAr":"فِى جَنَّةٍ عَالِيَةٍۢ","textEn":"in an elevated Garden,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":5978,"textAr":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","textEn":"where no idle talk will be heard.","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":5979,"textAr":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","textEn":"In it will be a running spring,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":5980,"textAr":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","textEn":"along with thrones raised high,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":5981,"textAr":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","textEn":"and cups set at hand,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":5982,"textAr":"وَنَمَارِقُ مَصْفُوفَةٌۭ","textEn":"and ˹fine˺ cushions lined up,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":5983,"textAr":"وَزَرَابِىُّ مَبْثُوثَةٌ","textEn":"and ˹splendid˺ carpets spread out.","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":5984,"textAr":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","textEn":"Do they not ever reflect on camels—how they were ˹masterfully˺ created;","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":5985,"textAr":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","textEn":"and the sky—how it was raised ˹high˺;","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":5986,"textAr":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","textEn":"and the mountains—how they were firmly set up;","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":20,"ayahNoQuran":5987,"textAr":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","textEn":"and the earth—how it was levelled out?","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":21,"ayahNoQuran":5988,"textAr":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","textEn":"So, ˹continue to˺ remind ˹all, O  Prophet˺, for your duty is only to remind.","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":22,"ayahNoQuran":5989,"textAr":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","textEn":"You are not ˹there˺ to compel them ˹to believe˺.","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":23,"ayahNoQuran":5990,"textAr":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","textEn":"But whoever turns away, persisting in disbelief,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":24,"ayahNoQuran":5991,"textAr":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","textEn":"then Allah will inflict upon them the major punishment.","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":25,"ayahNoQuran":5992,"textAr":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","textEn":"Surely to Us is their return,","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false},{"ayahNo":26,"ayahNoQuran":5993,"textAr":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","textEn":"then surely with Us is their reckoning.","juz":30,"manzil":7,"ruku":530,"hizbQuarter":237,"isSajdah":false}]}