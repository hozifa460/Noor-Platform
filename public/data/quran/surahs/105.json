{"surahNo":105,"nameAr":"الفيل","nameEn":"The Elephant","nameRoman":"Al-Fil","placeOfRevelation":"Meccan","totalAyahs":5,"ayahs":[{"ayahNo":1,"ayahNoQuran":6189,"textAr":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","textEn":"Have you not seen ˹O Prophet˺ how your Lord dealt with the Army of the Elephant?","juz":30,"manzil":7,"ruku":547,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6190,"textAr":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","textEn":"Did He not frustrate their scheme?","juz":30,"manzil":7,"ruku":547,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6191,"textAr":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","textEn":"For He sent against them flocks of birds,","juz":30,"manzil":7,"ruku":547,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6192,"textAr":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","textEn":"that pelted them with stones of baked clay,","juz":30,"manzil":7,"ruku":547,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6193,"textAr":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","textEn":"leaving them like chewed up straw.","juz":30,"manzil":7,"ruku":547,"hizbQuarter":240,"isSajdah":false}]}