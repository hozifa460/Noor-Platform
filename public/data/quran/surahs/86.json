{"surahNo":86,"nameAr":"الطارق","nameEn":"The Nightcommer","nameRoman":"At-Tariq","placeOfRevelation":"Meccan","totalAyahs":17,"ayahs":[{"ayahNo":1,"ayahNoQuran":5932,"textAr":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","textEn":"By the heaven and the nightly star!","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":5933,"textAr":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","textEn":"And what will make you realize what the nightly star is?","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":5934,"textAr":"ٱلنَّجْمُ ٱلثَّاقِبُ","textEn":"˹It is˺ the star of piercing brightness.","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":5935,"textAr":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","textEn":"There is no soul without a vigilant angel ˹recording everything˺.","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5936,"textAr":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","textEn":"Let people then consider what they were created from!","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":5937,"textAr":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","textEn":"˹They were˺ created from a spurting fluid,","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":5938,"textAr":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","textEn":"stemming from between the backbone and the ribcage.","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":5939,"textAr":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","textEn":"Surely He is fully capable of bringing them back ˹to life˺","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":5940,"textAr":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","textEn":"on the Day all secrets will be disclosed.","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":5941,"textAr":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","textEn":"Then one will have neither power nor ˹any˺ helper.","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":5942,"textAr":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","textEn":"By the sky with its recurring cycles,","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":5943,"textAr":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","textEn":"and the earth with its sprouting plants!","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":5944,"textAr":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","textEn":"Surely this ˹Quran˺ is a decisive word,","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":5945,"textAr":"وَمَا هُوَ بِٱلْهَزْلِ","textEn":"and is not to be taken lightly.","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":5946,"textAr":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","textEn":"They are certainly devising ˹evil˺ plans,","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":5947,"textAr":"وَأَكِيدُ كَيْدًۭا","textEn":"but I too am planning.","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":5948,"textAr":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","textEn":"So bear with the disbelievers ˹O Prophet˺. Let them be for ˹just˺ a little while.","juz":30,"manzil":7,"ruku":528,"hizbQuarter":236,"isSajdah":false}]}