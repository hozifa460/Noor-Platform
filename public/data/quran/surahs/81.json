{"surahNo":81,"nameAr":"التكوير","nameEn":"The Overthrowing","nameRoman":"At-Takwir","placeOfRevelation":"Meccan","totalAyahs":29,"ayahs":[{"ayahNo":1,"ayahNoQuran":5801,"textAr":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","textEn":"When the sun is put out,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":5802,"textAr":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","textEn":"and when the stars fall down,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":5803,"textAr":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","textEn":"and when the mountains are blown away,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":5804,"textAr":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","textEn":"and when pregnant camels are left untended,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":5805,"textAr":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","textEn":"and when wild beasts are gathered together,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":5806,"textAr":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","textEn":"and when the seas are set on fire,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":5807,"textAr":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","textEn":"and when the souls ˹and their bodies˺ are paired ˹once more˺,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":5808,"textAr":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","textEn":"and when baby girls, buried alive, are asked","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":5809,"textAr":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","textEn":"for what crime they were put to death,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":5810,"textAr":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","textEn":"and when the records ˹of deeds˺ are laid open,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":5811,"textAr":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","textEn":"and when the sky is stripped away,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":12,"ayahNoQuran":5812,"textAr":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","textEn":"and when the Hellfire is fiercely flared up,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":13,"ayahNoQuran":5813,"textAr":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","textEn":"and when Paradise is brought near—","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":14,"ayahNoQuran":5814,"textAr":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","textEn":"˹on that Day˺ each soul will know what ˹deeds˺ it has brought along.","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":15,"ayahNoQuran":5815,"textAr":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","textEn":"I do swear by the receding stars","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":16,"ayahNoQuran":5816,"textAr":"ٱلْجَوَارِ ٱلْكُنَّسِ","textEn":"which travel and hide,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":17,"ayahNoQuran":5817,"textAr":"وَٱلَّيْلِ إِذَا عَسْعَسَ","textEn":"and the night as it falls","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":18,"ayahNoQuran":5818,"textAr":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","textEn":"and the day as it breaks!","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":19,"ayahNoQuran":5819,"textAr":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","textEn":"Indeed, this ˹Quran˺ is the Word of ˹Allah delivered by Gabriel,˺ a noble messenger-angel,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":20,"ayahNoQuran":5820,"textAr":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","textEn":"full of power, held in honour by the Lord of the Throne,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":21,"ayahNoQuran":5821,"textAr":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","textEn":"obeyed there ˹in heaven˺, and trustworthy.","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":22,"ayahNoQuran":5822,"textAr":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","textEn":"And your fellow man is not insane.","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":23,"ayahNoQuran":5823,"textAr":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","textEn":"And he did see that ˹angel˺ on the clear horizon,","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":24,"ayahNoQuran":5824,"textAr":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","textEn":"and he does not withhold ˹what is revealed to him of˺ the unseen.","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":25,"ayahNoQuran":5825,"textAr":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","textEn":"And this ˹Quran˺ is not the word of an outcast devil.","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":26,"ayahNoQuran":5826,"textAr":"فَأَيْنَ تَذْهَبُونَ","textEn":"So what ˹other˺ path would you take?","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":27,"ayahNoQuran":5827,"textAr":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","textEn":"Surely this ˹Quran˺ is only a reminder to the whole world—","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":28,"ayahNoQuran":5828,"textAr":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","textEn":"to whoever of you wills to take the Straight Way.","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false},{"ayahNo":29,"ayahNoQuran":5829,"textAr":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","textEn":"But you cannot will ˹to do so˺, except by the Will of Allah, the Lord of all worlds.","juz":30,"manzil":7,"ruku":523,"hizbQuarter":234,"isSajdah":false}]}