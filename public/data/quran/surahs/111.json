{"surahNo":111,"nameAr":"المسد","nameEn":"The Palm Fiber","nameRoman":"Al-Masad","placeOfRevelation":"Meccan","totalAyahs":5,"ayahs":[{"ayahNo":1,"ayahNoQuran":6217,"textAr":"تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ","textEn":"May the hands of Abu Lahab perish, and he ˹himself˺ perish!","juz":30,"manzil":7,"ruku":553,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6218,"textAr":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","textEn":"Neither his wealth nor ˹worldly˺ gains will benefit him.","juz":30,"manzil":7,"ruku":553,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6219,"textAr":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ","textEn":"He will burn in a flaming Fire,","juz":30,"manzil":7,"ruku":553,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6220,"textAr":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","textEn":"and ˹so will˺ his wife, the carrier of ˹thorny˺ kindling,","juz":30,"manzil":7,"ruku":553,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6221,"textAr":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ","textEn":"around her neck will be a rope of palm-fibre.","juz":30,"manzil":7,"ruku":553,"hizbQuarter":240,"isSajdah":false}]}