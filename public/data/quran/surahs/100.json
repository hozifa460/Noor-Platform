{"surahNo":100,"nameAr":"العاديات","nameEn":"The Courser","nameRoman":"Al-'Adiyat","placeOfRevelation":"Meccan","totalAyahs":11,"ayahs":[{"ayahNo":1,"ayahNoQuran":6147,"textAr":"وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","textEn":"’ By the galloping, panting horses,","juz":30,"manzil":7,"ruku":542,"hizbQuarter":239,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6148,"textAr":"فَٱلْمُورِيَٰتِ قَدْحًۭا","textEn":"striking sparks of fire ˹with their hoofs˺,","juz":30,"manzil":7,"ruku":542,"hizbQuarter":239,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6149,"textAr":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","textEn":"launching raids at dawn,","juz":30,"manzil":7,"ruku":542,"hizbQuarter":239,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6150,"textAr":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","textEn":"stirring up ˹clouds of˺ dust,","juz":30,"manzil":7,"ruku":542,"hizbQuarter":239,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6151,"textAr":"فَوَسَطْنَ بِهِۦ جَمْعًا","textEn":"and penetrating into the heart of enemy lines!","juz":30,"manzil":7,"ruku":542,"hizbQuarter":239,"isSajdah":false},{"ayahNo":6,"ayahNoQuran":6152,"textAr":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","textEn":"Surely humankind is ungrateful to their Lord—","juz":30,"manzil":7,"ruku":542,"hizbQuarter":239,"isSajdah":false},{"ayahNo":7,"ayahNoQuran":6153,"textAr":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","textEn":"and they certainly attest to this—","juz":30,"manzil":7,"ruku":542,"hizbQuarter":239,"isSajdah":false},{"ayahNo":8,"ayahNoQuran":6154,"textAr":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","textEn":"and they are truly extreme in their love of ˹worldly˺ gains.","juz":30,"manzil":7,"ruku":542,"hizbQuarter":239,"isSajdah":false},{"ayahNo":9,"ayahNoQuran":6155,"textAr":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","textEn":"Do they not know that when the contents of the graves will be spilled out,","juz":30,"manzil":7,"ruku":542,"hizbQuarter":240,"isSajdah":false},{"ayahNo":10,"ayahNoQuran":6156,"textAr":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","textEn":"and the secrets of the hearts will be laid bare—","juz":30,"manzil":7,"ruku":542,"hizbQuarter":240,"isSajdah":false},{"ayahNo":11,"ayahNoQuran":6157,"textAr":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","textEn":"surely their Lord is All-Aware of them on that Day.","juz":30,"manzil":7,"ruku":542,"hizbQuarter":240,"isSajdah":false}]}