{"surahNo":113,"nameAr":"الفلق","nameEn":"The Daybreak","nameRoman":"Al-Falaq","placeOfRevelation":"Meccan","totalAyahs":5,"ayahs":[{"ayahNo":1,"ayahNoQuran":6226,"textAr":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","textEn":"Say, ˹O Prophet,˺ “I seek refuge in the Lord of the daybreak","juz":30,"manzil":7,"ruku":555,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6227,"textAr":"مِن شَرِّ مَا خَلَقَ","textEn":"from the evil of whatever He has created,","juz":30,"manzil":7,"ruku":555,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6228,"textAr":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","textEn":"and from the evil of the night when it grows dark,","juz":30,"manzil":7,"ruku":555,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6229,"textAr":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","textEn":"and from the evil of those ˹witches casting spells by˺ blowing onto knots,","juz":30,"manzil":7,"ruku":555,"hizbQuarter":240,"isSajdah":false},{"ayahNo":5,"ayahNoQuran":6230,"textAr":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","textEn":"and from the evil of an envier when they envy.”","juz":30,"manzil":7,"ruku":555,"hizbQuarter":240,"isSajdah":false}]}