{"surahNo":112,"nameAr":"الإخلاص","nameEn":"The Sincerity","nameRoman":"Al-Ikhlas","placeOfRevelation":"Meccan","totalAyahs":4,"ayahs":[{"ayahNo":1,"ayahNoQuran":6222,"textAr":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","textEn":"Say, ˹O Prophet,˺ “He is Allah—One ˹and Indivisible˺;","juz":30,"manzil":7,"ruku":554,"hizbQuarter":240,"isSajdah":false},{"ayahNo":2,"ayahNoQuran":6223,"textAr":"ٱللَّهُ ٱلصَّمَدُ","textEn":"Allah—the Sustainer ˹needed by all˺.","juz":30,"manzil":7,"ruku":554,"hizbQuarter":240,"isSajdah":false},{"ayahNo":3,"ayahNoQuran":6224,"textAr":"لَمْ يَلِدْ وَلَمْ يُولَدْ","textEn":"He has never had offspring, nor was He born.","juz":30,"manzil":7,"ruku":554,"hizbQuarter":240,"isSajdah":false},{"ayahNo":4,"ayahNoQuran":6225,"textAr":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","textEn":"And there is none comparable to Him.”","juz":30,"manzil":7,"ruku":554,"hizbQuarter":240,"isSajdah":false}]}