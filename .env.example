# ==============================================================================
# Noor Platform — Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=production

# Distributed Rate Limiting & Edge Cache (Optional, defaults to in-memory)
# Upstash Redis REST credentials:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Or Vercel KV REST credentials:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Security Hardening Flags
# Set to 'true' in multi-instance production to enforce distributed rate limiting (returns 503 if Redis unreachable)
REQUIRE_DISTRIBUTED_RATELIMIT="false"

# Set to 'true' ONLY if running behind a trusted reverse proxy (Cloudflare, Nginx, Caddy, AWS ALB).
# When 'false', client IP header spoofing (X-Forwarded-For, etc.) is ignored. Automatically handled on Vercel.
TRUSTED_PROXY="false"

# Shared-secret between the reverse proxy and this app (recommended when TRUSTED_PROXY=false).
# Caddy injects it as `X-Noor-Proxy-Secret` (see Caddyfile). When set and matching,
# the rate limiter trusts proxy IP headers → per-visitor limits instead of one shared bucket.
# Generate with:  openssl rand -hex 32   (must match Caddy env PROXY_SECRET)
PROXY_SECRET=""

# Next.js Port (Default: 3000)
PORT=3000
