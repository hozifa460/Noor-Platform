# ==============================================================================
# Noor Platform — Environment Configuration Template
# Deployment target: Vercel (Next.js serverless). Copy to .env.local for dev.
# ==============================================================================

# YouTube Data API v3 — used by /api/sheikh-avatar to resolve channel avatars.
# Without it the route degrades gracefully to SVG initials.
YOUTUBE_API_KEY=""

# Distributed rate limiting for /api/* (optional, defaults to in-memory per instance).
# Upstash Redis REST credentials:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Or Vercel KV REST credentials:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Set to 'true' in production to return 503 instead of falling back to
# in-memory limits when Redis is unreachable.
REQUIRE_DISTRIBUTED_RATELIMIT="false"

# Client IP resolution. On Vercel the platform sets x-real-ip / x-forwarded-for
# and this is handled automatically — leave 'false'. Only set 'true' when
# self-hosting behind a reverse proxy you control.
TRUSTED_PROXY="false"

# Optional shared secret injected by a self-hosted reverse proxy as
# `X-Noor-Proxy-Secret`. Not needed on Vercel. Generate: openssl rand -hex 32
PROXY_SECRET=""

# Public base URL for large datasets served from a CDN (optional).
NEXT_PUBLIC_DATA_BASE=""
